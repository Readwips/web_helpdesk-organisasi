DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/it_helpdesk"
PORT=5000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173"
TRUST_PROXY=false
SESSION_COOKIE_NAME=helpdesk_session
CSRF_COOKIE_NAME=helpdesk_csrf
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOGIN_LOCK_THRESHOLD=5
TOTP_ENCRYPTION_KEY="replace-with-a-long-random-secret"
TOTP_ISSUER="IT Helpdesk"
TURNSTILE_SECRET_KEY="replace-with-cloudflare-secret"
